# ── 前台設定 ──
NEXT_PUBLIC_STORE_NAME="URBANITE"
NEXT_PUBLIC_SITE_URL="https://urbanite-tw.vercel.app"

# ── Supabase(資料庫 + 登入)──
# 在 Supabase 後台 → Project Settings → API 取得
NEXT_PUBLIC_SUPABASE_URL=""            # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=""       # anon public 金鑰
SUPABASE_SERVICE_ROLE_KEY=""           # service_role 金鑰(機密,絕不外流)

# ── 後台管理員白名單 ──
# 只有這些 Email 的社群帳號登入後才進得了後台,多個用逗號分隔
ADMIN_EMAILS="dreamndream0@gmail.com"

# ── 綠界 ECPay 金流 ──
ECPAY_ENV="stage"                       # stage(測試) | production(正式)
ECPAY_MERCHANT_ID=""                    # 綠界商店編號(測試 3002607)
ECPAY_HASH_KEY=""                       # 綠界 HashKey(測試 pwFHCqoQZGmho4w6)
ECPAY_HASH_IV=""                        # 綠界 HashIV(測試 EkRm7iFT261dpevs)

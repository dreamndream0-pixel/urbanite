# ── 前台設定 ──
NEXT_PUBLIC_STORE_NAME="URBANITE"
NEXT_PUBLIC_SITE_URL="https://www.urbanite.com.tw"

# ── Supabase(資料庫 + 登入)──
# 在 Supabase 後台 → Project Settings → API 取得
NEXT_PUBLIC_SUPABASE_URL=""            # Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=""       # anon public 金鑰
SUPABASE_SERVICE_ROLE_KEY=""           # service_role 金鑰(機密,絕不外流)

# ── LINE Login(網站自行串接,不要用 Supabase Custom OIDC)──
LINE_LOGIN_CHANNEL_ID=""               # LINE Developers → LINE Login Channel ID
LINE_LOGIN_CHANNEL_SECRET=""           # LINE Developers → LINE Login Channel secret

# ── 後台管理員白名單 ──
# 只有這些 Email 的社群帳號登入後才進得了後台,多個用逗號分隔
ADMIN_EMAILS="dreamndream0@gmail.com"

# ── 藍新 NewebPay 金流 ──
NEWEBPAY_ENV="stage"                    # stage(測試) | production(正式)
NEWEBPAY_MERCHANT_ID=""                 # 藍新商店代號 MerchantID
NEWEBPAY_HASH_KEY=""                    # 藍新 HashKey(32 字元)
NEWEBPAY_HASH_IV=""                     # 藍新 HashIV(16 字元)

# ── 藍新 NewebPay 物流(可留空沿用上方金流設定) ──
NEWEBPAY_LOGISTICS_ENV=""               # stage(測試) | production(正式)
NEWEBPAY_LOGISTICS_UID=""               # 藍新物流 NWP 商店代號
NEWEBPAY_LOGISTICS_HASH_KEY=""          # 藍新物流 HashKey
NEWEBPAY_LOGISTICS_HASH_IV=""           # 藍新物流 HashIV

# ── Apple Pay 幕後支付網域驗證(選用,要用網站直接 Apple Pay 才需要)──
# 藍新後台下載的驗證檔內容,供 /.well-known/apple-developer-merchantid-domain-association 回傳
APPLE_PAY_DOMAIN_ASSOCIATION=""
